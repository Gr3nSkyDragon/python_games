# PyInstaller work folders
build/
dist/

# Python bytecode
__pycache__/
*.pyc

# Built games: run build.cmd, then zip Games/ for a release
Games/

# Local Python environment created by build.cmd
.venv/

# Phonicsmon save file (the game creates a fresh one if missing)
phonixmons_save.dat

# Full-size originals of shrunk images (tools/shrink_images.py); zip for releases
originals/

# Per-machine game settings (e.g. Star CVC volumes)
*_settings.json

# Kokoro voice demo (local only, see kokoro_demo/README.txt)
kokoro_demo/
